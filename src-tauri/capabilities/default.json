{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Marvis domain access plus folder selection, window close, title-bar dragging, and double-click zoom.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:allow-open"
  ]
}
